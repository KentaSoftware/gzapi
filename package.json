{
  "name": "gzapi",
  "version": "1.0.0",
  "description": "API REST Golozur - backend para ventas, compras, productos, clientes y usuarios",
  "main": "app.ts",
  "scripts": {
    "lint": "ts-standard",
    "dev": "nodemon ./src/server.ts",
    "build": "tsc",
    "vercel-build": "npm run build && node -r ts-node/register migrations/demo-002-build-seed.ts",
    "start": "node ./dist/server.js",
    "test": "cross-env TS_NODE_TRANSPILE_ONLY=1 NODE_OPTIONS=--no-strip-types mocha -r ts-node/register \"test/**/*.test.ts\" --timeout 10000",
    "test:phase0:performance": "cross-env TS_NODE_TRANSPILE_ONLY=1 NODE_OPTIONS=--no-strip-types mocha -r ts-node/register \"test/phase0/performance.test.ts\" --timeout 60000",
    "migration:phase0:preflight": "node -r ts-node/register migrations/phase-0-001-preflight.ts",
    "migration:phase0:backup": "node -r ts-node/register migrations/phase-0-002-backup-verify.ts",
    "migration:phase0:indexes": "node -r ts-node/register migrations/phase-0-003-create-commercial-fact-indexes.ts",
    "migration:phase0:verify": "node -r ts-node/register migrations/phase-0-004-verify.ts",
    "migration:stock:preflight": "node -r ts-node/register migrations/stock-001-preflight.ts",
    "migration:stock:indexes": "node -r ts-node/register migrations/stock-002-create-indexes.ts",
    "migration:stock:opening-template": "node -r ts-node/register migrations/stock-003-opening-count-template.ts",
    "migration:stock:opening-count": "node -r ts-node/register migrations/stock-004-apply-opening-count.ts",
    "migration:stock:repair-projections": "node -r ts-node/register migrations/stock-005-repair-projections.ts",
    "migration:stock:verify": "node -r ts-node/register migrations/stock-006-verify.ts",
    "seed:route-plan:test": "node -r ts-node/register migrations/route-plan-002-seed-test-data.ts",
    "seed:demo": "node -r ts-node/register migrations/demo-001-seed-data.ts"
  },
  "author": "turo1111",
  "license": "UNLICENSED",
  "dependencies": {
    "@types/form-data": "^2.2.1",
    "axios": "^1.13.2",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "date-fns": "^3.6.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "form-data": "^4.0.5",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.17.21",
    "mongodb": "^6.8.0",
    "mongoose": "^8.0.3",
    "multer": "^1.4.5-lts.1",
    "pdfkit": "^0.15.0",
    "sharp": "^0.33.4",
    "typescript": "^5.3.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/chai": "^4.3.11",
    "@types/cors": "^2.8.17",
    "@types/dotenv": "^8.2.0",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/lodash": "^4.14.202",
    "@types/mocha": "^10.0.6",
    "@types/mongoose": "^5.11.97",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.5",
    "@types/pdfkit": "^0.13.5",
    "@types/proxyquire": "^1.3.31",
    "@types/sharp": "^0.32.0",
    "@types/sinon": "^17.0.3",
    "@types/supertest": "^6.0.3",
    "chai": "^4.4.1",
    "cross-env": "^7.0.3",
    "mocha": "^10.7.3",
    "nodemon": "^3.1.11",
    "proxyquire": "^2.1.3",
    "sinon": "^17.0.1",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "ts-standard": "^12.0.2"
  },
  "eslintConfig": {
    "parserOptions": {
      "project": "./tsconfig.json"
    },
    "extends": [
      "./node_modules/ts-standard/eslintrc.json"
    ]
  }
}
