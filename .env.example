# App
PORT=3002

# Auth
JWT_SECRET=change-me

# Seed inicial de admin (solo se usa si no existe el usuario admin)
ADMIN_PASSWORD=change-me

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/gzapi

# Document AI (opcional)
DOCUMENT_AI_URL=http://localhost:8000
DOCUMENT_AI_TIMEOUT=240000
DOCUMENT_AI_DEBUG=1

# Upload de comprobantes (opcional)
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_MIMES=image/jpeg,image/png,image/webp,application/pdf

# Backup / restore (opcional)
# OJO: el código actual usa USER y PASS literalmente en src/controllers/backup.ts
BACKUP_URI=mongodb://127.0.0.1:27017
USER=backup-user
PASS=backup-password
